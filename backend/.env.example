# ─────────────────────────────────────────────────────────────────────────────
# Test Yourself — Backend environment variables (placeholders only).
# Copy to `.env` and fill real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# Core
APP_NAME=Test Yourself API
DEBUG=false
ENVIRONMENT=production           # development | production | test
API_PREFIX=/api

# Database (production = PostgreSQL)
# Example local: postgresql+psycopg2://postgres:postgres@localhost:5432/test_yourself
# SQLite is ONLY for local dev/tests:
#   sqlite:///./dev.db
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@localhost:5432/test_yourself

# ── Security ────────────────────────────────────────────────────────────────
# Generate a strong random value, e.g. `openssl rand -hex 32`
SECRET_KEY=CHANGE_ME__openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_MIN_LENGTH=8

# ── CORS (frontend origins allowed to call the API) ─────────────────────────
CORS_ORIGINS=["http://localhost:5173","https://test-yourself.vercel.app"]
