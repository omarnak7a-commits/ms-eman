# Frontend (Vite) — consumed at build time. NEVER put secrets in VITE_* vars:
# everything prefixed with VITE_ is inlined into the public JavaScript bundle.
#
# Leave VITE_API_URL UNSET for the standard single-project Vercel deployment:
# the SPA and the API share one origin, so the client calls `/api/...` directly.
# Set it only when the FastAPI backend is hosted on a different domain, e.g.
# VITE_API_URL=https://your-backend.example.com/api
