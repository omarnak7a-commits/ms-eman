# Dependencies
node_modules/

# Build output — NEVER commit the built frontend.
# Vercel builds `frontend/` itself (see vercel.json `buildCommand`), so a
# committed bundle can only go stale and serve an index.html that points at
# asset hashes which no longer exist (the mobile white-screen failure mode).
dist/
build/
coverage/
.vite/

# Logs
*.log
npm-debug.log*

# OS/editor
.DS_Store
*.local

# Python / backend
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
*.db
*.sqlite3

# Environment files (never commit secrets)
.env
.env.*
!.env.example

# Local scratch / reports
TECHNICAL_REPORT.md
